# ============================================================
#  环境变量模板
#  用法：复制成 .env 再填自己的值。  cp .env.example .env
#  ⚠️ .env 已被 .gitignore 忽略，绝不会上传到 GitHub
# ============================================================

# ---------- 应用 ----------
APP_NAME=RAG-DocQA
APP_ENV=dev                       # dev / prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---------- 鉴权 ----------
# 留空 = 关闭鉴权（本地开发方便）；部署到公网必须设置
API_KEY=
# 前端调用后端时带的 key，要和上面一致
RAG_API_KEY=

# ---------- LLM 提供商 ----------
# 可选值：openai / deepseek / zhipu / moonshot / ollama / offline
LLM_PROVIDER=offline
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=                     # 留空用各provider默认值
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# 其他常见组合（把上面 4 行换掉即可）：
#   DeepSeek:  LLM_PROVIDER=deepseek  LLM_MODEL=deepseek-chat          LLM_API_KEY=sk-xxx
#   智谱GLM:   LLM_PROVIDER=zhipu     LLM_MODEL=glm-4-flash            LLM_API_KEY=xxx.xxx
#   Ollama:    LLM_PROVIDER=ollama    LLM_MODEL=qwen2.5:7b             LLM_BASE_URL=http://localhost:11434/v1
#   OpenAI:    LLM_PROVIDER=openai    LLM_MODEL=gpt-4o-mini            LLM_API_KEY=sk-xxx

# ---------- Embedding 提供商 ----------
# 可选值：openai / local / hash
#   openai → 走 API，效果好，要钱
#   local  → 本地 BGE 中文模型，免费离线（需装 requirements-local.txt）
#   hash   → 纯 Python 哈希向量，零依赖零成本，效果一般（默认兜底）
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=64

# ---------- 文档切分 ----------
CHUNK_SIZE=500                    # 每个分块字符数
CHUNK_OVERLAP=80                  # 相邻分块重叠字符数
MAX_FILE_SIZE_MB=50               # 上传文件大小上限

# ---------- 检索 ----------
TOP_K=5                           # 最终返回给 LLM 的片段数
FETCH_K=20                        # 初筛候选数（向量/BM25各取这么多）
HYBRID_ENABLED=true               # 是否开启 向量+BM25 混合检索
RRF_K=60                          # RRF 融合平滑系数
RERANK_ENABLED=true               # 是否开启启发式重排序
SCORE_THRESHOLD=0.0               # 低于该相似度的片段丢弃

# ---------- 存储路径 ----------
CHROMA_DIR=data/chroma
DOCS_DIR=data/docs
COLLECTION_NAME=default

# ---------- 多轮对话 ----------
MEMORY_ENABLED=true
MEMORY_MAX_TURNS=6                # 保留最近 N 轮对话
SESSION_TTL_MINUTES=120
